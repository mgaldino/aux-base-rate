{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mechanisms (JSONL line)",
  "type": "object",
  "required": ["question_id"],
  "anyOf": [
    { "required": ["mechanisms"] },
    { "required": ["mechanisms_yes", "mechanisms_no"] }
  ],
  "properties": {
    "question_id": { "type": "string" },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "prior_weight": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "mechanisms_yes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "prior_weight": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "mechanisms_no": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "prior_weight": { "type": "number" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
