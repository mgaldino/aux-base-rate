{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Outside-view output record (JSONL line)",
  "type": "object",
  "required": ["question_id", "prompt_id", "base_rate", "prompt", "raw_response", "meta"],
  "properties": {
    "question_id": { "type": "string" },
    "prompt_id": { "type": "string" },
    "base_rate": { "type": ["number", "null"] },
    "prompt": {
      "type": "object",
      "required": ["system", "user"],
      "properties": {
        "system": { "type": "string" },
        "user": { "type": "string" }
      },
      "additionalProperties": true
    },
    "raw_response": { "type": ["string", "null"] },
    "parse_error": { "type": ["string", "null"] },
    "call_error": { "type": ["string", "null"] },
    "meta": {
      "type": "object",
      "required": ["model", "temperature", "run_ts"],
      "properties": {
        "model": { "type": "string" },
        "temperature": { "type": "number" },
        "run_ts": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
